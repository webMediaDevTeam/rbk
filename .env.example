APP_NAME="RBQBot"
APP_ENV=local
APP_DEBUG=true
# Clé d'encryption Laravel — vide ici : `php artisan key:generate`
# (c'est backend/.env qui la porte en développement)
APP_KEY=
APP_URL=http://localhost

# IP publique du serveur — lue par docker-compose.prod.yml pour
# APP_URL / FRONTEND_URL / VPS_IP et le build-arg VITE_API_URL du bundle
VPS_IP=51.255.192.50
FRONTEND_URL=http://51.255.192.50

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rbqbot
DB_USERNAME=rbqbot
DB_PASSWORD=rbqbot
DB_ROOT_PASSWORD=root

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Origines CORS autorisées (séparées par des virgules, SANS slash final)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://51.255.192.50

REVERB_HOST=0.0.0.0
REVERB_PORT=8080
VITE_API_URL=http://localhost:8000

# --- Phase 1 : variables MySQL consommées par docker compose (${...}) ---
MYSQL_DATABASE=rbqbot
MYSQL_USER=rbqbot
MYSQL_PASSWORD=rbqbot
MYSQL_ROOT_PASSWORD=root

# --- Phase 1 : credentials Laravel Reverb (serveur WebSocket) ---
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
